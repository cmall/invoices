<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %><%= s.business_name ? ` · ${s.business_name}` : '' %></title>
<link rel="stylesheet" href="/static/app.css">
<% const hex = (c, d) => /^#[0-9a-f]{6}$/i.test(c || '') ? c : d; %>
<style>:root{--accent:<%= hex(s.accent_color, '#2f5d8a') %>;--heading:<%= hex(s.heading_color, hex(s.accent_color, '#2f5d8a')) %>}</style>
</head>
<body>
<% if (loggedIn) { %>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/"><% if (s.logo_file) { %><img src="/logo?v=<%= s.logo_file %>" alt="<%= s.business_name || 'Home' %>" class="brand-logo"><% } else { %><span><%= s.business_name || 'Invoices' %></span><% } %></a>
    <nav>
      <% const nav = [['/', 'Dashboard'], ['/invoices', 'Invoices'], ['/estimates', 'Estimates'], ['/clients', 'Clients'], ['/projects', 'Projects'], ['/reports', 'Reports'], ['/settings', 'Settings']]; %>
      <% for (const [href, label] of nav) { const active = href === '/' ? path === '/' : path.startsWith(href); %>
        <a href="<%= href %>" class="<%= active ? 'active' : '' %>"><%= label %></a>
      <% } %>
    </nav>
    <form method="post" action="/logout" class="logout"><button class="link">Log out</button></form>
  </div>
</header>
<% } %>
<main class="<%= loggedIn ? 'container' : 'container narrow' %>">
<% if (flash) { %><div class="flash ok"><%= flash %></div><% } %>
<% if (flashError) { %><div class="flash err"><%= flashError %></div><% } %>
