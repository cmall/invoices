<%- include('partials/head') %>
<div class="card login">
  <% if (s.logo_file) { %><img src="/logo?v=<%= s.logo_file %>" alt="<%= s.business_name %>" class="login-logo"><% } else { %><h1><%= s.business_name || 'Invoices' %></h1><% } %>
  <% if (setupNeeded) { %>
    <div class="flash err">No admin password is configured yet. On the server, run <code>npm run setup</code> and restart the app.</div>
  <% } %>
  <% if (error) { %><div class="flash err"><%= error %></div><% } %>
  <form method="post" action="/login" class="stack">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Email <input type="email" name="email" autocomplete="username" required autofocus></label>
    <label>Password <input type="password" name="password" autocomplete="current-password" required></label>
    <button class="btn primary">Log in</button>
  </form>
</div>
<%- include('partials/foot') %>
