<%- include('../partials/head') %>
<% const isInv = kind === 'invoice'; const m = (c) => u.formatMoney(c, doc.currency); %>
<div class="page-head">
  <div>
    <h1><%= label %> <%= doc.number %> <%- include('../partials/status', { status: doc.display_status }) %></h1>
    <div class="muted"><% if (multiBusiness) { %><span class="from-pill" style="--accent:<%= biz.accent_color %>"><%= businessName %></span> → <% } %><a href="/clients/<%= doc.client_id %>"><%= doc.client_name %></a><%= doc.subject ? ` · ${doc.subject}` : '' %></div>
  </div>
  <div class="actions">
    <% if (doc.status !== 'void' && doc.status !== 'invoiced') { %><a class="btn" href="<%= base %>/<%= doc.id %>/edit">Edit</a><% } %>
    <a class="btn" href="<%= base %>/<%= doc.id %>/pdf" target="_blank">PDF</a>
    <% if (doc.status !== 'void') { %>
      <a class="btn primary" href="<%= base %>/<%= doc.id %>/send"><%= doc.status === 'draft' ? 'Send…' : 'Send again…' %></a>
    <% } %>
  </div>
</div>

<% if (isInv && doc.status === 'draft' && doc.auto_send_on) { %>
  <div class="card schedule-banner">
    <div class="schedule-icon"><%- include('../partials/icon', { name: 'clock', size: 22 }) %></div>
    <div class="schedule-text">
      <strong>Scheduled to email automatically <%= doc.auto_send_on <= today ? 'within the hour' : `on ${u.formatDate(doc.auto_send_on)}` %></strong>
      <span class="muted small">To <%= doc.client.email || 'the client (no email address set!)' %>, with the PDF attached. You can still edit it until then.<% if (recurringProfile) { %> Created by <a href="/recurring/<%= recurringProfile.id %>"><%= recurringProfile.name || recurringProfile.subject || 'a recurring invoice' %></a>.<% } %></span>
    </div>
    <div class="schedule-actions">
      <form method="post" action="/invoices/<%= doc.id %>/auto-send" class="inline-form">
        <%- include('../partials/csrf') %>
        <input type="date" name="date" value="<%= doc.auto_send_on %>" min="<%= today %>" aria-label="Send date">
        <button class="btn small">Change date</button>
      </form>
      <form method="post" action="/invoices/<%= doc.id %>/auto-send"><%- include('../partials/csrf') %><input type="hidden" name="action" value="cancel"><button class="btn small">Don't send automatically</button></form>
    </div>
  </div>
<% } else if (isInv && doc.status === 'draft' && recurringProfile) { %>
  <div class="card schedule-banner review">
    <div class="schedule-icon"><%- include('../partials/icon', { name: 'eye', size: 22 }) %></div>
    <div class="schedule-text">
      <strong>Staged for your review</strong>
      <span class="muted small">Created by <a href="/recurring/<%= recurringProfile.id %>"><%= recurringProfile.name || recurringProfile.subject || 'a recurring invoice' %></a>. Check it over, then send it, or schedule it to go out on its own.</span>
    </div>
    <div class="schedule-actions">
      <a class="btn small primary" href="/invoices/<%= doc.id %>/send"><%- include('../partials/icon', { name: 'send', size: 15 }) %> Send now</a>
      <form method="post" action="/invoices/<%= doc.id %>/auto-send" class="inline-form">
        <%- include('../partials/csrf') %>
        <input type="date" name="date" value="<%= doc.issue_date >= today ? doc.issue_date : today %>" min="<%= today %>" aria-label="Send date">
        <button class="btn small">Send automatically</button>
      </form>
    </div>
  </div>
<% } else if (doc.status === 'draft') { %>
  <div class="card notice"><%- include('../partials/icon', { name: 'edit' }) %><div>This <%= label.toLowerCase() %> is a <strong>draft</strong>. Keep adding lines as you work, then send it when you're ready. Clients can't see drafts.
    <% if (isInv) { %>
      <details class="mt"><summary>Schedule it to send automatically</summary>
        <form method="post" action="/invoices/<%= doc.id %>/auto-send" class="inline-form">
          <%- include('../partials/csrf') %>
          <input type="date" name="date" value="<%= doc.issue_date >= today ? doc.issue_date : today %>" min="<%= today %>" aria-label="Send date" class="w-date">
          <button class="btn small">Schedule</button>
        </form>
      </details>
    <% } %>
  </div></div>
<% } else if (recurringProfile) { %>
  <p class="muted small recurring-note"><%- include('../partials/icon', { name: 'repeat', size: 14 }) %> Created by <a href="/recurring/<%= recurringProfile.id %>"><%= recurringProfile.name || recurringProfile.subject || 'a recurring invoice' %></a></p>
<% } %>
<% if (doc.paid_cents && doc.status !== 'paid' && doc.status !== 'void' && doc.balance_cents < 0) { %>
  <div class="card notice warn">Payments exceed the total by <%= m(-doc.balance_cents) %>.</div>
<% } %>

<div class="show-grid">
  <div>
    <%- include('preview', { doc }) %>

    <% if (doc.is_editable) { %>
    <div class="card" id="lines">
      <h2>Add a line</h2>
      <%- include('../partials/quickadd', { doc, base, projects, returnTo: 'document' }) %>
      <% if (doc.lines.length) { %>
      <details class="mt">
        <summary>Remove a line</summary>
        <table class="table compact">
          <% for (const l of doc.lines) { %>
            <tr>
              <td><%= l.item_date ? u.formatDate(l.item_date) : '' %></td>
              <td class="truncate"><%= l.description || l.kind %></td>
              <td class="num"><%= m(l.amount_cents) %></td>
              <td class="num"><form method="post" action="<%= base %>/<%= doc.id %>/lines/<%= l.id %>/delete"><%- include('../partials/csrf') %><button class="link danger">Remove</button></form></td>
            </tr>
          <% } %>
        </table>
      </details>
      <% } %>
    </div>
    <% } %>
  </div>

  <aside>
    <% if (doc.status !== 'draft') { %>
    <div class="card">
      <h3>Client link</h3>
      <div class="copy-row">
        <input readonly value="<%= publicLink %>" data-copy-source>
        <button type="button" class="btn small" data-copy>Copy</button>
      </div>
      <p class="hint"><% if (doc.viewed_at) { %>First viewed <%= u.formatDateTime(doc.viewed_at) %><% } else { %>Not viewed yet<% } %></p>
    </div>
    <% } %>

    <% if (isInv && doc.status !== 'void') { %>
    <div class="card" id="payments">
      <h3>Payments</h3>
      <% if (!doc.payments.length) { %><p class="muted">No payments recorded.</p><% } %>
      <% for (const p of doc.payments) { %>
        <div class="payment">
          <div>
            <strong><%= m(p.amount_cents) %></strong> · <%= u.formatDate(p.paid_date) %><br>
            <span class="muted"><%= paymentMethods[p.method] || p.method %><%= p.reference ? ` · ${p.reference}` : '' %></span>
            <% if (p.notes) { %><div class="muted"><%= p.notes %></div><% } %>
          </div>
          <form method="post" action="<%= base %>/<%= doc.id %>/payments/<%= p.id %>/delete" data-confirm="Delete this payment?"><%- include('../partials/csrf') %><button class="link danger">Delete</button></form>
        </div>
        <div class="receipt-row">
          <% if (p.receipt_sent_at) { %>
            <span class="receipt-sent"><%- include('../partials/icon', { name: 'check', size: 14 }) %> Receipt sent <%= u.formatDateTime(p.receipt_sent_at) %></span>
          <% } %>
          <span class="receipt-actions">
            <a class="btn small<%= p.receipt_sent_at ? '' : ' primary' %>" href="<%= base %>/<%= doc.id %>/payments/<%= p.id %>/receipt"><%- include('../partials/icon', { name: 'send', size: 14 }) %> <%= p.receipt_sent_at ? 'Resend' : 'Send receipt' %></a>
            <a class="btn small" href="<%= base %>/<%= doc.id %>/payments/<%= p.id %>/receipt.pdf" target="_blank" title="Receipt PDF"><%- include('../partials/icon', { name: 'download', size: 14 }) %> PDF</a>
          </span>
        </div>
      <% } %>
      <% if (doc.balance_cents > 0) { %>
      <details <%= doc.payments.length ? '' : '' %>>
        <summary>Record a payment</summary>
        <form method="post" action="<%= base %>/<%= doc.id %>/payments" class="stack">
          <%- include('../partials/csrf') %>
          <label>Amount <input name="amount" inputmode="decimal" value="<%= u.centsToInput(doc.balance_cents) %>" required></label>
          <label>Date <input type="date" name="paid_date" value="<%= today %>"></label>
          <label>Method
            <select name="method">
              <% for (const [k, v] of Object.entries(paymentMethods)) { if (k === 'stripe') continue; %><option value="<%= k %>"><%= v %></option><% } %>
            </select>
          </label>
          <label>Reference <input name="reference" placeholder="Cheque #, transfer ID…"></label>
          <% if (emailReady && doc.client.email) { %>
            <label class="check"><input type="checkbox" name="send_receipt" value="1" checked> Email a receipt to <%= doc.client.email %></label>
          <% } else { %>
            <p class="hint"><%= emailReady ? 'Add an email address to this client to send receipts.' : 'Set up email to send receipts.' %> You can download a receipt PDF once the payment is recorded.</p>
          <% } %>
          <button class="btn primary">Record payment</button>
        </form>
      </details>
      <% } %>
    </div>
    <% } %>

    <div class="card">
      <h3>Actions</h3>
      <div class="action-list">
        <% if (doc.status === 'draft') { %>
          <form method="post" action="<%= base %>/<%= doc.id %>/mark-sent"><%- include('../partials/csrf') %><button class="link">Mark as sent (without emailing)</button></form>
        <% } %>
        <% if (isInv && doc.is_overdue) { %>
          <a href="<%= base %>/<%= doc.id %>/send?purpose=reminder">Send a payment reminder…</a>
        <% } %>
        <% if (!isInv && ['draft','sent','accepted','declined'].includes(doc.status)) { %>
          <form method="post" action="<%= base %>/<%= doc.id %>/convert"><%- include('../partials/csrf') %><button class="link">Convert to invoice</button></form>
          <% if (doc.status !== 'accepted') { %><form method="post" action="<%= base %>/<%= doc.id %>/mark-accepted"><%- include('../partials/csrf') %><button class="link">Mark as accepted</button></form><% } %>
          <% if (doc.status !== 'declined') { %><form method="post" action="<%= base %>/<%= doc.id %>/mark-declined"><%- include('../partials/csrf') %><button class="link">Mark as declined</button></form><% } %>
        <% } %>
        <% if (!isInv && doc.converted_invoice_id) { %><a href="/invoices/<%= doc.converted_invoice_id %>">View invoice</a><% } %>
        <% if (isInv && doc.source_estimate_id) { %><a href="/estimates/<%= doc.source_estimate_id %>">View original estimate</a><% } %>
        <a href="<%= base %>/<%= doc.id %>/pdf?download=1">Download PDF</a>
        <% if (isInv) { %><a href="/recurring/new?from=<%= doc.id %>">Make recurring…</a><% } %>
        <form method="post" action="<%= base %>/<%= doc.id %>/duplicate"><%- include('../partials/csrf') %><button class="link">Duplicate</button></form>
        <% if (doc.status !== 'draft' && !doc.payments.length && doc.status !== 'invoiced') { %>
          <form method="post" action="<%= base %>/<%= doc.id %>/revert-draft"><%- include('../partials/csrf') %><button class="link">Move back to draft</button></form>
        <% } %>
        <% if (isInv && doc.status !== 'void' && doc.status !== 'draft') { %>
          <form method="post" action="<%= base %>/<%= doc.id %>/void" data-confirm="Void this invoice? It stays in your records but is no longer payable."><%- include('../partials/csrf') %><button class="link danger">Void invoice</button></form>
        <% } %>
        <% if (!doc.payments.length) { %>
          <form method="post" action="<%= base %>/<%= doc.id %>/delete" data-confirm="Delete <%= doc.number %> permanently?"><%- include('../partials/csrf') %><button class="link danger">Delete</button></form>
        <% } %>
      </div>
    </div>

    <div class="card">
      <h3>History</h3>
      <ul class="activity">
        <% for (const a of doc.activity) { %><li><span><%= a.message %></span><time><%= u.formatDateTime(a.created_at) %></time></li><% } %>
      </ul>
      <% const failed = doc.emails.filter(e => e.error); if (failed.length) { %>
        <h4>Email errors</h4>
        <ul class="activity">
          <% for (const e of failed) { %><li class="error"><span><%= e.error %></span><time><%= u.formatDateTime(e.created_at) %></time></li><% } %>
        </ul>
      <% } %>
    </div>
  </aside>
</div>
<%- include('../partials/foot') %>
