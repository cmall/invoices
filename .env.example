# Copy to .env and fill in. Never commit .env.

# Public URL of the app, e.g. https://invoices.example.com (used in emails, Stripe redirects, PDFs)
APP_URL=
PORT=3000
# IANA time zone used to decide "today" for due dates and reminders
TZ=UTC

# Admin login. Generate the hash with:  npm run hash-password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Long random string used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Postmark (Servers -> your server -> API Tokens)
POSTMARK_SERVER_TOKEN=
# Message stream for transactional mail (usually "outbound")
POSTMARK_MESSAGE_STREAM=outbound

# Stripe (Developers -> API keys, and the webhook signing secret for /webhooks/stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where the SQLite database, logo and backups live (default ./data)
DATA_DIR=./data

# In-app updates (Updates page) follow this GitHub branch. Set UPDATES_ENABLED=0 to turn them off.
UPDATE_BRANCH=main
